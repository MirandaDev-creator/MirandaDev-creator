<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 240" width="800" height="240" role="img" aria-labelledby="t d" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <title id="t">Tux fazendo parkour</title>
  <desc id="d">O pinguim do Linux corre, faz um mortal sobre uma caixa, sobe em uma parede e salta uma barreira com um mortal para frente.</desc>

  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0d1117"/>
      <stop offset="1" stop-color="#161b22"/>
    </linearGradient>
  </defs>

  <style>
    .runx  { animation: runx 9s linear infinite; }
    .jumpy { animation: jumpy 9s linear infinite; }
    .spin  { animation: spin 9s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
    .shadow{ animation: shadow 9s linear infinite; transform-box: fill-box; transform-origin: center; }

    .footA { animation: step .35s ease-in-out infinite; }
    .footB { animation: step .35s ease-in-out infinite; animation-delay: -.175s; }
    .wing  { animation: swing .35s ease-in-out infinite alternate; transform-box: fill-box; transform-origin: 50% 0%; }

    @keyframes runx {
      0%   { transform: translateX(-60px); }
      88%  { transform: translateX(860px); }
      100% { transform: translateX(860px); }
    }

    @keyframes jumpy {
      0%   { transform: translateY(0); }
      24%  { transform: translateY(0);     animation-timing-function: cubic-bezier(.2,.7,.4,1); }
      30%  { transform: translateY(-90px); animation-timing-function: cubic-bezier(.6,0,.8,.4); }
      36%  { transform: translateY(0); }
      43%  { transform: translateY(0);     animation-timing-function: cubic-bezier(.2,.7,.4,1); }
      46%  { transform: translateY(-95px); animation-timing-function: cubic-bezier(.6,0,.8,.4); }
      48.5%{ transform: translateY(-60px); }
      52.5%{ transform: translateY(-60px); animation-timing-function: cubic-bezier(.6,0,.8,.4); }
      57%  { transform: translateY(0); }
      61%  { transform: translateY(0);     animation-timing-function: cubic-bezier(.2,.7,.4,1); }
      66.5%{ transform: translateY(-80px); animation-timing-function: cubic-bezier(.6,0,.8,.4); }
      72%  { transform: translateY(0); }
      100% { transform: translateY(0); }
    }

    @keyframes spin {
      0%, 25% { transform: rotate(0deg); }
      35%, 63% { transform: rotate(-360deg); }
      71%, 100% { transform: rotate(0deg); }
    }

    @keyframes shadow {
      0%, 24% { transform: scale(1);  opacity: .35; }
      30%     { transform: scale(.6); opacity: .15; }
      36%, 43%{ transform: scale(1);  opacity: .35; }
      47%, 52.5% { transform: scale(.6); opacity: .15; }
      57%, 61%{ transform: scale(1);  opacity: .35; }
      66.5%   { transform: scale(.6); opacity: .15; }
      72%, 100% { transform: scale(1); opacity: .35; }
    }

    @keyframes step {
      0%, 100% { transform: translateX(-6px); }
      50%      { transform: translateX(6px); }
    }

    @keyframes swing {
      from { transform: rotate(-28deg); }
      to   { transform: rotate(28deg); }
    }

    @media (prefers-reduced-motion: reduce) {
      .runx, .jumpy, .spin, .shadow, .footA, .footB, .wing { animation: none; }
      .runx { transform: translateX(150px); }
    }
  </style>

  <!-- Palco -->
  <rect x="1" y="1" width="798" height="238" rx="12" fill="url(#bg)" stroke="#30363d" stroke-width="2"/>
  <text x="22" y="30" font-family="'Fira Code', Consolas, 'Courier New', monospace" font-size="13" fill="#8b949e">tux@linux:~$ <tspan fill="#58a6ff">./parkour.sh</tspan></text>

  <!-- Chao -->
  <rect x="1" y="170" width="798" height="69" rx="0" fill="#0d1117"/>
  <line x1="1" y1="170" x2="799" y2="170" stroke="#30363d" stroke-width="2"/>
  <g stroke="#21262d" stroke-width="2">
    <line x1="40" y1="195" x2="90" y2="195"/>
    <line x1="170" y1="210" x2="240" y2="210"/>
    <line x1="330" y1="195" x2="380" y2="195"/>
    <line x1="500" y1="212" x2="570" y2="212"/>
    <line x1="660" y1="196" x2="730" y2="196"/>
  </g>

  <!-- Obstaculo 1: caixa -->
  <g>
    <rect x="235" y="132" width="40" height="38" fill="#0b2a3d" stroke="#0077b6" stroke-width="2"/>
    <line x1="235" y1="132" x2="275" y2="170" stroke="#0077b6" stroke-width="1.5"/>
    <line x1="275" y1="132" x2="235" y2="170" stroke="#0077b6" stroke-width="1.5"/>
  </g>

  <!-- Obstaculo 2: parede -->
  <g>
    <rect x="428" y="110" width="44" height="60" fill="#21262d" stroke="#58a6ff" stroke-width="2"/>
    <g stroke="#30363d" stroke-width="1.5">
      <line x1="428" y1="130" x2="472" y2="130"/>
      <line x1="428" y1="150" x2="472" y2="150"/>
      <line x1="450" y1="110" x2="450" y2="130"/>
      <line x1="439" y1="130" x2="439" y2="150"/>
      <line x1="461" y1="130" x2="461" y2="150"/>
      <line x1="450" y1="150" x2="450" y2="170"/>
    </g>
  </g>

  <!-- Obstaculo 3: barreira -->
  <g>
    <rect x="620" y="142" width="4" height="28" fill="#58a6ff"/>
    <rect x="656" y="142" width="4" height="28" fill="#58a6ff"/>
    <rect x="620" y="140" width="40" height="5" rx="2" fill="#0077b6"/>
  </g>

  <!-- Sombra -->
  <g transform="translate(0 170)">
    <g class="runx">
      <ellipse class="shadow" cx="0" cy="2" rx="22" ry="4" fill="#000"/>
    </g>
  </g>

  <!-- Tux -->
  <g transform="translate(0 170)">
    <g class="runx">
      <g class="jumpy">
        <g class="spin">
          <!-- asa (atras) -->
          <ellipse class="wing" cx="-19" cy="-34" rx="6" ry="16" fill="#1b2028" stroke="#6e7681" stroke-width="1.5"/>
          <!-- corpo -->
          <ellipse cx="0" cy="-36" rx="20" ry="30" fill="#2b3340" stroke="#6e7681" stroke-width="1.5"/>
          <!-- barriga -->
          <ellipse cx="4" cy="-28" rx="13" ry="20" fill="#f0f3f6"/>
          <!-- olhos -->
          <circle cx="3"  cy="-52" r="4.5" fill="#ffffff"/>
          <circle cx="13" cy="-52" r="4.5" fill="#ffffff"/>
          <circle cx="4.5"  cy="-52" r="2" fill="#0d1117"/>
          <circle cx="14.5" cy="-52" r="2" fill="#0d1117"/>
          <!-- bico -->
          <polygon points="12,-47 29,-43 12,-39" fill="#f5a623"/>
          <!-- pes -->
          <ellipse class="footA" cx="-4" cy="-3" rx="10" ry="4" fill="#f5a623"/>
          <ellipse class="footB" cx="10" cy="-3" rx="10" ry="4" fill="#e08e0b"/>
        </g>
      </g>
    </g>
  </g>
</svg>
